# Copy to .env.local (never commit) or set in GitHub Actions secrets.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
#
# Or point at a local JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\play-service-account.json
#
# Play Console: invite the service account, grant View app information
# and Manage store presence / Edit store listing on each app in
# play-listings.config.json. Enable "Google Play Android Developer API"
# in the linked Google Cloud project.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
